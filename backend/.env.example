NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://progym:progym@localhost:5432/progym?schema=public
FRONTEND_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
COOKIE_DOMAIN=localhost
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# hybrid keeps both a database fallback and a local file. Use filesystem on Hostinger.
FILE_STORAGE_MODE=hybrid
# Hostinger: set an absolute persistent path outside the replaceable Node.js build folder.
UPLOAD_ROOT=uploads
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_OBSERVER_1_USERNAME=observer.1
SEED_OBSERVER_1_PASSWORD=replace-with-a-strong-observer-password
SEED_OBSERVER_2_USERNAME=observer.2
SEED_OBSERVER_2_PASSWORD=replace-with-a-strong-observer-password
SEED_OBSERVER_3_USERNAME=observer.3
SEED_OBSERVER_3_PASSWORD=replace-with-a-strong-observer-password
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=replace-with-a-demo-password
