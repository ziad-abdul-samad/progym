{
  "name": "@progym/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "start": "node dist/main.js",
